# book.config - Padroes da PLATAFORMA (valem para todos os livros)
#
# Cada livro tem o seu proprio livros/<slug>/book.config, que sobrescreve
# estes valores com titulo, autor, meta de palavras e idioma.

# Extensao padrao dos arquivos de escrita criados pelos scripts
BOOK_EXT="txt"

# Criar arquivos novos vazios (1) ou a partir dos templates (0)
BOOK_EMPTY_BY_DEFAULT=1

# Editor padrao: nvim | code | qualquer comando no PATH
BOOK_EDITOR="nvim"

# Animacao de abertura do menu: 1 liga, 0 desliga
BOOK_ANIMATION=1

# Como exibir o GIF de abertura:
#   auto (detecta) | imgcat (iTerm2) | chafa | kitty | viu | ascii (sem imagem)
BOOK_ANIM_PLAYER="auto"

# Valores usados apenas quando um livro nao define os seus
BOOK_AUTHOR="Daniel Moraes"
BOOK_LANG="pt-BR"
BOOK_WORD_GOAL=80000
