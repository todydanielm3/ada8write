# book.config - Configuracao do livro "Meu Livro Uma odiceia do saber"
# Vale apenas para este livro. Padroes da plataforma ficam em ../../book.config

BOOK_TITLE="Uma Odisseia do saber"
BOOK_AUTHOR="Daniel Moraes"
BOOK_LANG="pt-BR"
BOOK_WORD_GOAL=80000

# Formato dos arquivos criados (txt por padrao)
BOOK_EXT="txt"
